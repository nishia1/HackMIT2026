# Required. There is no in-memory fallback any more: every read is a real
# user's real data, so the app needs a database to start.
MONGODB_URI=
MONGODB_DB=invisible-string

# Signs the session cookie. `npx auth secret` generates one.
AUTH_SECRET=
# Only on Vercel, and only if auto-detection gets the URL wrong.
# AUTH_URL=https://your-app.vercel.app

# Dropbox is the sign-in as well as the photo source, so these are the only
# credentials the app needs. No account token belongs in here — each user's
# tokens are granted by them and live on their user document.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

OPENAI_API_KEY=
BLOB_READ_WRITE_TOKEN=        # fallback only

# Redirect URIs to register in the Dropbox App Console:
#   http://localhost:3000/api/auth/callback/dropbox
#   https://<your-app>/api/auth/callback/dropbox
