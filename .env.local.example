# Leave MONGODB_URI empty and the app serves the seeded demo world from memory.
MONGODB_URI=
MONGODB_DB=invisible-string

# Sign in as someone else in the seeded world. Defaults to "you".
DEMO_USER_ID=

AUTH_SECRET=                  # npx auth secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Run `npm run dropbox:auth` for this. Access tokens last four hours; a
# refresh token does not, so the app renews itself from then on.
DROPBOX_REFRESH_TOKEN=

# A four-hour token from the App Console, if you'd rather skip the OAuth step.
DROPBOX_ACCESS_TOKEN=

# Where your camera roll actually lives. Phone sync creates /Camera Uploads.
DROPBOX_CAMERA_FOLDER=/Camera Uploads

OPENAI_API_KEY=
BLOB_READ_WRITE_TOKEN=        # fallback only
