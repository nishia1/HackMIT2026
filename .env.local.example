# Copy to .env.local. Never commit that file.

# --- Dev 1, AI and plans ---------------------------------------------
# Without this the planner silently falls back to templates, which is a
# supported path — the app still works, the copy is just flatter.
OPENAI_API_KEY=

# Optional. Point at any OpenAI-compatible endpoint (e.g. a sponsor's) and
# set the model name to match. Leave both blank for OpenAI's own API.
# Check the provider supports json_schema response formats before switching.
OPENAI_BASE_URL=
LLM_MODEL=

# Optional. Free key from developer.ticketmaster.com, takes about two minutes.
# Without it you still get the hand-written events in
# src/data/candidateEvents.json — places come from OpenStreetMap and need no key.
TICKETMASTER_API_KEY=

# --- Dev 2, auth and files -------------------------------------------
# The Google client needs the calendar.readonly scope added to the sign-in
# for the planner to suggest real times. One extra scope, not a second flow.
AUTH_SECRET=                  # npx auth secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=           # starts with GOCSPX-

# Temporary, Dev 1 only. An access token from developers.google.com/oauthplayground
# so `npm run check:calendar` can hit the real API before auth exists.
# Expires after an hour. Delete once sign-in works.
GOOGLE_TEST_ACCESS_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
BLOB_READ_WRITE_TOKEN=        # fallback only, if Dropbox OAuth dies

# --- Dev 3, data ------------------------------------------------------
MONGODB_URI=
