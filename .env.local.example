# Leave these unset and the import runs on a built-in sample camera roll.
# Set them and /api/import reads your real folder — metadata only, never writes.
#
# From https://www.dropbox.com/developers/apps — scopes files.metadata.read
# and files.content.read. Then run `npm run dropbox:auth` for the refresh token.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# A four-hour token from the App Console, if you'd rather skip the OAuth step.
DROPBOX_ACCESS_TOKEN=

DROPBOX_CAMERA_FOLDER=/Camera Uploads

# Confirmed events, and who was at them. Without this the import screen still
# scans and clusters, but nothing can be saved.
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net
# Local: mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DB=invisible-string
